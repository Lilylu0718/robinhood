<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  robinhood-bot 每日执行。安装：
    cp com.lilylu.robinhood-bot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.lilylu.robinhood-bot.plist
  卸载：
    launchctl unload ~/Library/LaunchAgents/com.lilylu.robinhood-bot.plist
  时间是本机本地时区（America/Los_Angeles）。工作日 13:15 跑一次（= 美东 16:15 收盘后）。
  2026-09-22 起从每天 2 次减到 1 次：省 Claude 月度用量，且信号本来就是日线收盘算的，
  10:00 那次盘中检查价值有限。Mac 睡着时跳过，醒来补跑一次。run_daily.sh 内部对单次跑
  失败有 3 次重试（0s/60s/180s 退避）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lilylu.robinhood-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lilylu/robinhood-bot/run_daily.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/lilylu/robinhood-bot/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lilylu/robinhood-bot/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
